# Supabase (mesmo projeto do web). Anon key — nunca service role.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Catálogo de cinema (opcional). Sem isso, o cadastro de filme é só manual.
# Se estiver vazio, o app reaproveita VITE_TMDB_API_KEY do .env da raiz.
EXPO_PUBLIC_TMDB_API_KEY=

# Catálogo de livros (opcional). Sem chave o app ainda tenta a API pública.
# Se estiver vazio, o app reaproveita VITE_GOOGLE_BOOKS_API_KEY do .env da raiz.
EXPO_PUBLIC_GOOGLE_BOOKS_API_KEY=
