{
  "manifest_version": 3,
  "name": "Orbyva",
  "version": "0.1.0",
  "description": "Painel fixo do Orbyva: hábitos, orçamento e salvar filmes, livros, música e lugares.",
  "action": {
    "default_title": "Orbyva",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["sidePanel", "tabs", "contextMenus", "storage", "scripting"],
  "host_permissions": ["https://orbyva.app/*", "http://localhost:5173/*", "https://*/*", "http://*/*"],
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
