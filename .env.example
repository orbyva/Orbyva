VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_TMDB_API_KEY=          # preferencial — busca de filmes/séries em pt-BR
VITE_OMDB_API_KEY=          # fallback opcional se TMDB não estiver configurada

# Observabilidade (opcional)
# VITE_SENTRY_DSN=
# VITE_POSTHOG_KEY=phc_...
# VITE_POSTHOG_HOST=https://us.i.posthog.com

# Billing / Stripe (opcional até configurar)
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
# VITE_BILLING_FORCE_PRO=true   # bypass do teste 7 dias / força Pro (dev)

# E2E autenticado (Playwright) — opcional
# E2E_EMAIL=teste@orbyva.app
# E2E_PASSWORD=...
# E2E_EMAIL_B=teste-b@orbyva.app   # 2ª conta para teste RLS (Fase G)
# E2E_PASSWORD_B=...

