VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_TMDB_API_KEY=          # preferencial — busca de filmes/séries em pt-BR
VITE_OMDB_API_KEY=          # fallback opcional se TMDB não estiver configurada

# Observabilidade (opcional)
# VITE_SENTRY_DSN=
# VITE_POSTHOG_KEY=phc_...
# VITE_POSTHOG_HOST=https://us.i.posthog.com

# Billing / Stripe (opcional até configurar)
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
# VITE_BILLING_FORCE_PRO=true   # bypass do teste 7 dias / força Pro (dev)

# E2E autenticado (Playwright) — opcional
# E2E_EMAIL=teste@orbyva.app
# E2E_PASSWORD=...

# --- Secrets das Edge Functions Stripe (quando for cobrar) ---
# SITE_URL=https://seu-dominio.vercel.app
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PRICE_ID_PRO=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# --- Retenção D7 (e-mail de retorno) ---
# Rode scripts/retention.sql (ou migration 20260725220000_retention_d7)
# Deploy: supabase functions deploy retention-d7-email
# Secrets: CRON_SECRET, RESEND_API_KEY, RESEND_FROM, SITE_URL
# Opcional analytics: POSTHOG_API_KEY, POSTHOG_HOST
# Cron diário (Supabase Dashboard → Edge Functions → Schedules, ou curl):
#   curl -X POST "$SUPABASE_URL/functions/v1/retention-d7-email" \
#     -H "Authorization: Bearer $CRON_SECRET"
# RESEND_FROM=Orbyva <noreply@orbyva.app>   # domínio verificado no Resend
# CRON_SECRET=um-segredo-longo
# RESEND_API_KEY=re_...
