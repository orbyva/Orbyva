# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Livros
VITE_GOOGLE_BOOKS_API_KEY=

# Lugares + rotas + clima (Edge Function places-catalog) — NÃO expor no Vite.
# Secrets no Supabase (qualquer um resolve; específico > GOOGLE_MAPS_API_KEY):
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_ROUTES_API_KEY=
GOOGLE_WEATHER_API_KEY=
# Cotas freemium mensais (fail-closed). Defaults abaixo do free oficial (10k/5k).
MAPS_QUOTA_ENFORCE=true
GOOGLE_PLACES_MONTHLY_LIMIT=9000
GOOGLE_ROUTES_ESSENTIALS_MONTHLY_LIMIT=9000
GOOGLE_ROUTES_PRO_MONTHLY_LIMIT=4500
GOOGLE_WEATHER_MONTHLY_LIMIT=9000

# Música
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Stripe
STRIPE_PRICE_ID_PRO=
VITE_STRIPE_PUBLISHABLE_KEY=
SITE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_BILLING_FORCE_PRO=

# Ops interno (/ops) — Edge Function ops-admin (csv de e-mails). NÃO é feature de produto.
OPS_ADMIN_EMAILS=

# PostHOG e Sentry
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# Originkit CLI (landing components) — não é secret de runtime do app
ORIGIN_KIT_KEY=

# E2E (Playwright) — preferir conta dedicada depois; por ora teardown apaga description like E2E*
E2E_EMAIL=
E2E_PASSWORD=
# Opcional: segundo usuário para teste de RLS
# E2E_EMAIL_B=
# E2E_PASSWORD_B=


# Resend
CRON_SECRET=
RESEND_API_KEY=
RESEND_FROM=
# Orb (IA do Orbyva) — Edge Function `orb-agent`. Secret no Supabase, NUNCA no Vite.
GEMINI_API_KEY=
# Opcional: sobrescreve o modelo padrão (gemini-3.1-flash-lite).
ORB_MODEL=
# Opcional: nível de raciocínio do Gemini 3 — MINIMAL | LOW (padrão) | MEDIUM | HIGH.
ORB_THINKING=

# Servidor MCP do projeto (`npm run mcp`) — ver mcp/README.md.
# URL/anon key caem para as VITE_* acima quando não definidas.
ORBYVA_SUPABASE_URL=
ORBYVA_SUPABASE_ANON_KEY=
# Para entrar, rode `npm run mcp:login`: grava só o refresh token em ~/.orbyva/credentials.json
# (0600). Não coloque a senha da conta aqui — ela permite trocar e-mail e senha, e este servidor
# é somente leitura. ORBYVA_EMAIL/ORBYVA_PASSWORD ainda funcionam, mas são legado (ver mcp/README).
# Override para CI: JWT pronto do usuário (expira em ~1h, não renova sozinho).
ORBYVA_ACCESS_TOKEN=
ORBYVA_TIMEZONE=America/Sao_Paulo
