# --- Assistente IA (Edge Function fintrack-agent) ---
# Recomendado: Groq (grátis, cota generosa) — https://console.groq.com/keys
# LLM_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# AGENT_RESPONSE_MODE=agent   # agent = IA redige resposta (1 chamada) | direct = só texto fixo

