# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Livros
VITE_GOOGLE_BOOKS_API_KEY=

# Lugares + rotas (Edge Function places-catalog) — NÃO expor no Vite.
# Secrets no Supabase:
GEOAPIFY_API_KEY=
GOOGLE_ROUTES_API_KEY=
# Cotas freemium (fail-closed). Defaults seguros abaixo do free oficial.
MAPS_QUOTA_ENFORCE=true
GEOAPIFY_DAILY_CREDIT_LIMIT=2800
GOOGLE_ROUTES_ESSENTIALS_MONTHLY_LIMIT=9000
GOOGLE_ROUTES_PRO_MONTHLY_LIMIT=4500

# Música
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Stripe
STRIPE_PRICE_ID_PRO=
VITE_STRIPE_PUBLISHABLE_KEY=
SITE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_BILLING_FORCE_PRO=

# Ops interno (/ops) — Edge Function ops-admin (csv de e-mails). NÃO é feature de produto.
OPS_ADMIN_EMAILS=

# PostHOG e Sentry
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# E2E (Playwright) — preferir conta dedicada depois; por ora teardown apaga description like E2E*
